// Пример для проверки в целевой платформе 1С. APIКлюч получает вызывающий код
// из защищённого хранилища; не храните его в тексте модуля или журнале.
Процедура СформироватьДокументCoDoc(Сервер, APIКлюч, ИдентификаторШаблона, Значения, ПутьPDF) Экспорт
    SSL = Новый ЗащищенноеСоединениеOpenSSL;
    Соединение = Новый HTTPСоединение(Сервер, 443, , , , 90, SSL);
    Данные = Новый Структура;
    Данные.Вставить("templateId", ИдентификаторШаблона);
    Данные.Вставить("format", "pdfa");
    Данные.Вставить("packAs", "single");
    Позиции = Новый Массив;
    Позиции.Добавить(Новый Структура("inlineValues", Значения));
    Данные.Вставить("items", Позиции);
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Данные);
    Тело = Запись.Закрыть();
    Запрос = Новый HTTPЗапрос("/client-api/generate/sync");
    Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Запрос.Заголовки.Вставить("X-API-Key", APIКлюч);
    Запрос.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8);
    Ответ = Соединение.ВызватьHTTPМетод("POST", Запрос);
    Если Ответ.КодСостояния <> 200 Тогда
        // Не включайте тело ответа или ключ в общедоступный журнал.
        ВызватьИсключение "CoDoc: HTTP " + Строка(Ответ.КодСостояния);
    КонецЕсли;
    Ответ.ПолучитьТелоКакДвоичныеДанные().Записать(ПутьPDF);
КонецПроцедуры

// Фото — ДвоичныеДанные PNG или JPEG. Возвращает структуру черновика:
// width, height, engine, warnings, elements. Ничего не сохраняет в CoDoc.
Функция РаспознатьФотоCoDoc(Сервер, APIКлюч, Фото, MIMEТип = "image/jpeg") Экспорт
    Если MIMEТип <> "image/jpeg" И MIMEТип <> "image/png" Тогда
        ВызватьИсключение "Поддерживаются PNG и JPEG";
    КонецЕсли;
    Данные = Новый Структура;
    Данные.Вставить("image", "data:" + MIMEТип + ";base64," + Base64Строка(Фото));
    Данные.Вставить("language", "rus+eng");
    Данные.Вставить("engine", "ocr");
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Данные);
    Запрос = Новый HTTPЗапрос("/client-api/recognition");
    Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Запрос.Заголовки.Вставить("X-API-Key", APIКлюч);
    Запрос.УстановитьТелоИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8);
    Соединение = Новый HTTPСоединение(Сервер, 443, , , , 150, Новый ЗащищенноеСоединениеOpenSSL);
    Ответ = Соединение.ВызватьHTTPМетод("POST", Запрос);
    Если Ответ.КодСостояния <> 200 Тогда
        ВызватьИсключение "Распознавание CoDoc: HTTP " + Строка(Ответ.КодСостояния);
    КонецЕсли;
    Чтение = Новый ЧтениеJSON;
    Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8));
    Результат = ПрочитатьJSON(Чтение);
    Чтение.Закрыть();
    Возврат Результат;
КонецФункции
