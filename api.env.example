# Copy to .env in ticket-infra. Generate independent random secrets (at least 32 characters).
JWT_SECRET=
APP_SECRETS_ENCRYPTION_KEY=
TYK_ADMIN_SECRET=
REDIS_PASSWORD=
APP_FRONTEND_URL=https://your-codoc-host.example
CLIENT_API_PUBLIC_URL=https://your-api-host.example/client-api
# Existing production database: keep validate. First boot on a NEW empty volume only: update.
DB_SCHEMA_MODE=validate
# Exact trusted origins, separated by commas. No wildcard; empty disables outbound connections.
CONNECTOR_ALLOWED_ORIGINS=
