# Copy to .env in ticket-infra. Generate independent random secrets (at least 32 characters).
JWT_SECRET=
APP_SECRETS_ENCRYPTION_KEY=
TYK_ADMIN_SECRET=
REDIS_PASSWORD=
APP_FRONTEND_URL=https://your-codoc-host.example
CLIENT_API_PUBLIC_URL=https://your-api-host.example/client-api
# Existing production database: keep validate. First boot on a NEW empty volume only: update.
DB_SCHEMA_MODE=validate
# Exact trusted origins, separated by commas. No wildcard; empty disables outbound connections.
CONNECTOR_ALLOWED_ORIGINS=
# Server-side poetry sources. MCP does not require an API key.
APP_POETRY_POEMSHIP_URL=https://poemship.com/mcp
APP_POETRY_POETREE_URL=https://versologie.cz/poetree/api
# Must match the external Nginx upstream (PostgreSQL/Compose deployment).
CODOC_HTTP_PORT=8090
# Optional private ni-c/osm-mcp HTTP bridge, bounded to 256 MiB / 0.5 CPU.
CODOC_WALK_MCP_ENABLED=false
OSM_MCP_ENABLED=false
OSM_MCP_URL=http://localhost:8000/mcp
COMMONS_MCP_ENABLED=true
COMMONS_MCP_URL=https://gateway.pipeworx.io/commons-wikimedia/mcp
# Private server-side Wikimapia credential; never use a VITE_ variable.
WIKIMAPIA_API_KEY=
