# Merge into the EXISTING .env beside the three repositories, not inside ticket-infra.
# Shell syntax: quote values with spaces or shell metacharacters. Do not replace existing secrets.
GOOGLE_CLIENT_ID='your-existing-google-client-id'
GOOGLE_CLIENT_SECRET='your-existing-google-client-secret'
JWT_SECRET='your-existing-jwt-secret-at-least-32-characters'
APP_FRONTEND_URL=https://www.codoc.site
# Keep the existing APP_SECRETS_ENCRYPTION_KEY. If it was absent, use the EXISTING JWT_SECRET.
# APP_SECRETS_ENCRYPTION_KEY='same-value-as-the-existing-JWT_SECRET'
DEPLOY_CLIENT_API=true
TYK_ADMIN_SECRET='generate-once-with-openssl-rand-hex-32'
REDIS_PASSWORD='generate-another-value-once-with-openssl-rand-hex-32'
APP_CLIENT_API_PUBLIC_URL=https://www.codoc.site/client-api
# Exact origins, comma-separated. Empty disables outbound connectors.
APP_CONNECTORS_ALLOWED_ORIGINS=''
# Server-side MCP; no browser CSP origin or mandatory API key is needed.
APP_POETRY_POEMSHIP_URL=https://poemship.com/mcp
APP_POETRY_POETREE_URL=https://versologie.cz/poetree/api
# PostgreSQL/Compose only. H2 deploy.sh uses port 8080 instead.
CODOC_HTTP_PORT=8090
# Update an existing external /etc/nginx/sites-available/codoc after app healthcheck.
# Requires noninteractive sudo. Backup + nginx -t + rollback are included.
CODOC_UPDATE_EXTERNAL_NGINX=false
# Defaults below match the old deployment. Set absolute paths if different.
# DATA_DIR=/home/ticket/ticket-data
# BACKUP_DIR=/home/ticket/ticket-data-backup
# Pass your real mail settings if delivery is needed. Never reuse the example password.
# SMTP_HOST=smtp.example.ru
# SMTP_PORT=465
# SMTP_USER='user@example.ru'
# SMTP_PASSWORD='your-password'
# SMTP_SSL=true
# SMTP_TLS=false
# EMAIL_FROM='user@example.ru'
